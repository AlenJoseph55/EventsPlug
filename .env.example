# Database connection string (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/eventsplug?schema=public"

# JWT configuration
JWT_SECRET="eventsplug-super-secret-key-change-in-prod"
JWT_EXPIRES_IN="7d"

# Local uploads directory (served statically by NestJS backend)
UPLOAD_PATH="./public/uploads"
PORT=5001
