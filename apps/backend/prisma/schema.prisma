datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum EventStatus {
  ACTIVE
  INACTIVE
  DRAFT
  CLOSED
}

enum UserRole {
  ORGANIZER
  SUPER_ADMIN
  ADMIN
  MANAGER
  MEMBER
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum PaymentGateway {
  NONE
  STRIPE
  RAZORPAY
  MANUAL_UPI
}

enum PaymentStatus {
  FREE
  PENDING_PAYMENT
  PAID
  FAILED
}

enum RegistrationStatus {
  CONFIRMED
  CANCELLED
}

enum IdentityType {
  EMAIL
}

model Organization {
  id                String             @id @default(uuid())
  slug              String             @unique
  name              String
  logoUrl           String?
  status            OrganizationStatus @default(ACTIVE)
  stripeAccountId   String?
  razorpayKeyId     String?
  razorpayKeySecret String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  events            Event[]
  users             User[]
  apiKeys           ApiKey[]
  webhookEndpoints  WebhookEndpoint[]
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  passwordHash   String
  role           UserRole     @default(ORGANIZER)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Event {
  id                      String         @id @default(uuid())
  organizationId          String
  organization            Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title                   String
  slug                    String
  description             String
  date                    DateTime?
  location                String?
  posterUrl               String?
  accentColor             String         @default("#3b82f6")
  maxRegistrations        Int?
  registrationDeadline    DateTime?
  status                  EventStatus    @default(ACTIVE)
  registrationTitle       String?        @default("Reserve your place")
  registrationDescription String?        @default("Complete the form below to confirm your spot.")
  registrationButtonLabel String?        @default("Register now")
  price                   Int            @default(0) // In cents or paisa
  currency                String         @default("USD")
  paymentGateway          PaymentGateway @default(NONE)
  upiId                   String?
  upiQrUrl                String?
  formFields              FormField[]
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  registrations           Registration[]

  @@unique([organizationId, slug])
}

enum FieldType {
  TEXT
  EMAIL
  TEXTAREA
  SELECT
  CHECKBOX
  NUMBER
}

model FormField {
  id              String    @id @default(uuid())
  eventId         String
  event           Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type            FieldType
  label           String
  placeholder     String?
  required        Boolean   @default(false)
  options         Json?     @default("[]") // string[]
  order           Int       @default(0)
  isIdentityField Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Registration {
  id              String             @id @default(uuid())
  eventId         String
  event           Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  answers         Json               // key-value form response map
  paymentStatus   PaymentStatus      @default(FREE)
  paymentAmount   Int?
  currency        String?
  paymentTxnId    String?
  paymentProofUrl String?
  status          RegistrationStatus @default(CONFIRMED)
  identityValue   String?
  identityType    IdentityType?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @default(now()) @updatedAt

  @@unique([eventId, identityValue])
}

model ApiKey {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  keyHash        String       @unique
  keyPrefix      String
  name           String
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model WebhookEndpoint {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  url            String
  name           String?
  signingSecret  String
  lastFailedAt   DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}


